# Maintainer: Gautham Sai <https://github.com/gautham-sai05>
pkgname=auralis
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial Apple Music client for Linux (Electron shell around music.apple.com)"
arch=('x86_64')
url="https://github.com/gautham-sai05/Auralis"
license=('MIT')
depends=('gtk3' 'nss' 'libxss' 'alsa-lib' 'libnotify' 'at-spi2-core')
makedepends=('nodejs' 'npm')
options=('!strip')
source=("git+https://github.com/gautham-sai05/Auralis.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/Auralis"
  npm ci
  npm run build
  npx electron-builder --linux dir --x64
}

package() {
  cd "$srcdir/Auralis"

  install -dm755 "$pkgdir/usr/lib/auralis"
  cp -r release/linux-unpacked/. "$pkgdir/usr/lib/auralis/"
  chmod 4755 "$pkgdir/usr/lib/auralis/chrome-sandbox"

  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/auralis" <<'EOF'
#!/bin/sh
exec /usr/lib/auralis/auralis "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/auralis"

  install -Dm644 build/auralis.desktop "$pkgdir/usr/share/applications/auralis.desktop"
  install -Dm644 build/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/auralis.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
